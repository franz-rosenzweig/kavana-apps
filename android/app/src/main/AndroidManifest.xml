<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the countdown during a block, which also keeps the check-ins and the cat on time -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- a timer: check-ins and the end at the minute, also in Doze -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- the cat over other apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- the account and the sync of your history (only when you sign in), and a sound's recording the first time it's picked -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KavanaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${cleartext}"
        android:theme="@style/Theme.Kavana">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Focus timer: shows the countdown of the running focus block and delivers its check-ins on time." />
        </service>

        <!-- Widgets -->
        <receiver android:name=".widget.WindowWidgetReceiver" android:exported="true" android:label="@string/widget_window_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/window_widget_info" />
        </receiver>
        <receiver android:name=".widget.QuickStartWidgetReceiver" android:exported="true" android:label="@string/widget_quick_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/quickstart_widget_info" />
        </receiver>
        <receiver android:name=".widget.TodayWidgetReceiver" android:exported="true" android:label="@string/widget_today_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/today_widget_info" />
        </receiver>
        <receiver android:name=".widget.LaterWidgetReceiver" android:exported="true" android:label="@string/widget_later_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/later_widget_info" />
        </receiver>
        <receiver android:name=".widget.SoundWidgetReceiver" android:exported="true" android:label="@string/widget_sound_name">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/sound_widget_info" />
        </receiver>
        <!-- Quick Settings tiles -->
        <service android:name=".widget.FocusTileService" android:exported="true" android:label="@string/tile_focus" android:icon="@drawable/ic_notify"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <service android:name=".widget.ParkTileService" android:exported="true" android:label="@string/tile_park" android:icon="@drawable/ic_tile_park"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
        </service>
        <service android:name=".widget.SoundTileService" android:exported="true" android:label="@string/tile_sound" android:icon="@drawable/ic_tile_sound"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
        <!-- The launcher's long-press shortcuts land here, do their one thing and go (no screen of its own) -->
        <activity android:name=".widget.ShortcutActivity" android:exported="false" android:theme="@style/Theme.Kavana.Transparent"
            android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true" />
        <!-- "Park a thought" from a widget: a small dialog over whatever is on the screen, not the whole app -->
        <activity
            android:name=".widget.ParkActivity"
            android:exported="false"
            android:theme="@style/Theme.Kavana.Transparent"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <receiver android:name=".PingReceiver" android:exported="false" />
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <receiver android:name=".DailyReceiver" android:exported="false" />
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
